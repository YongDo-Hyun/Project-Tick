# =================================================
# ProjT Launcher - Global defaults
# =================================================
* text=auto eol=lf

# =================================================
# Binary / never-touch files
# =================================================
*.ref           binary
*.pem           binary

*.doc           binary
*.docx          binary
*.pdf           binary
*.ai            binary
*.bin           binary
*.bmp           binary
*.dat           binary
*.gif           binary
*.ico           binary
*.jpeg          binary
*.jpg           binary
*.otf           binary
*.png           binary
*.psd           binary
*.ttf           binary
*.woff          binary
*.woff2         binary
*.xlsx          binary

# =================================================
# Git export hygiene
# =================================================
.gitattributes  export-ignore
.gitignore      export-ignore
.github/**      export-ignore

# =================================================
# Test data must remain byte-exact
# =================================================
**/testdata/**  -text -diff
