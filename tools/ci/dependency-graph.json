{
  "global_paths": [
    ".github/",
    "tools/ci/"
  ],
  "runners": {
    "bzip2": {
      "description": "bzip2 matrix validation lane"
    },
    "dockerimages": {
      "description": "Container image build lane"
    },
    "forgewrapper": {
      "description": "Forge wrapper Gradle build lane"
    },
    "gamemode": {
      "description": "GameMode build-and-test lane"
    },
    "javaloader": {
      "description": "Javaloader jar build lane"
    },
    "launcher": {
      "description": "ProjT Launcher integration lane"
    },
    "libnbtplusplus": {
      "description": "libnbtplusplus build-and-test lane"
    },
    "libpng": {
      "description": "libpng validation lane"
    },
    "localpeer": {
      "description": "LocalPeer build lane"
    },
    "meta": {
      "description": "Metadata generator lane"
    },
    "modpacks": {
      "description": "Modpack validation lane"
    },
    "murmur2": {
      "description": "murmur2 build lane"
    },
    "qdcss": {
      "description": "qdcss build lane"
    },
    "rainbow": {
      "description": "rainbow build lane"
    },
    "systeminfo": {
      "description": "systeminfo build-and-test lane"
    },
    "uvim": {
      "description": "uVim build-and-test lane"
    }
  },
  "nodes": {
    "bzip2": {
      "description": "Bundled compression library consumed by the launcher stack.",
      "paths": [
        "bzip2/"
      ],
      "depends_on": [],
      "runner": "bzip2"
    },
    "cgit": {
      "description": "Standalone cgit fork.",
      "paths": [
        "cgit/"
      ],
      "depends_on": []
    },
    "cmark": {
      "description": "Bundled Markdown parser consumed by the launcher.",
      "paths": [
        "cmark/"
      ],
      "depends_on": []
    },
    "corebinutils": {
      "description": "Standalone corebinutils fork.",
      "paths": [
        "corebinutils/"
      ],
      "depends_on": []
    },
    "dockerimages": {
      "description": "Docker image definitions used by CI and packaging.",
      "paths": [
        "dockerimages/"
      ],
      "depends_on": [],
      "runner": "dockerimages"
    },
    "extra-cmake-modules": {
      "description": "Bundled ECM modules used by the launcher build.",
      "paths": [
        "extra-cmake-modules/"
      ],
      "depends_on": []
    },
    "forgewrapper": {
      "description": "Forge installer wrapper project.",
      "paths": [
        "forgewrapper/"
      ],
      "depends_on": [],
      "runner": "forgewrapper"
    },
    "gamemode": {
      "description": "Standalone GameMode fork.",
      "paths": [
        "gamemode/"
      ],
      "depends_on": [],
      "runner": "gamemode"
    },
    "javacheck": {
      "description": "Java compatibility checker bundled into launcher builds.",
      "paths": [
        "javacheck/"
      ],
      "depends_on": []
    },
    "javaloader": {
      "description": "Bundled Java launcher shim consumed by the launcher build.",
      "paths": [
        "javaloader/"
      ],
      "depends_on": [],
      "runner": "javaloader"
    },
    "json4cpp": {
      "description": "Standalone JSON library fork.",
      "paths": [
        "json4cpp/"
      ],
      "depends_on": []
    },
    "libnbtplusplus": {
      "description": "Bundled NBT library consumed by the launcher.",
      "paths": [
        "libnbtplusplus/"
      ],
      "depends_on": [
        "ptlibzippy"
      ],
      "runner": "libnbtplusplus"
    },
    "libpng": {
      "description": "Bundled PNG library consumed by the launcher.",
      "paths": [
        "libpng/"
      ],
      "depends_on": [
        "ptlibzippy"
      ],
      "runner": "libpng"
    },
    "libqrencode": {
      "description": "Bundled QR encoder consumed by the launcher.",
      "paths": [
        "libqrencode/"
      ],
      "depends_on": []
    },
    "localpeer": {
      "description": "Bundled LocalPeer IPC helper consumed by the launcher.",
      "paths": [
        "LocalPeer/"
      ],
      "depends_on": [],
      "runner": "localpeer"
    },
    "meta": {
      "description": "Metadata generator and Nix packaging helpers.",
      "paths": [
        "meta/"
      ],
      "depends_on": [
        "forgewrapper"
      ],
      "runner": "meta"
    },
    "projt-launcher-quazip": {
      "description": "Bundled QuaZip consumed by the launcher.",
      "paths": [
        "quazip/"
      ],
      "depends_on": [
        "ptlibzippy"
      ]
    },
    "projt-launcher": {
      "description": "Primary launcher application.",
      "paths": [
        "projt-launcher/"
      ],
      "depends_on": [
        "bzip2",
        "cmark",
        "extra-cmake-modules",
        "javacheck",
        "javaloader",
        "libnbtplusplus",
        "libpng",
        "libqrencode",
        "localpeer",
        "projt-launcher-quazip",
        "ptlibzippy",
        "murmur2",
        "qdcss",
        "rainbow",
        "systeminfo",
        "tomlplusplus"
      ],
      "runner": "launcher"
    },
    "projt-minicraft-modpack": {
      "description": "MiniCraft modpack assets.",
      "paths": [
        "projt-minicraft-modpack/"
      ],
      "depends_on": [],
      "runner": "modpacks"
    },
    "projt-modpack": {
      "description": "Main modpack assets.",
      "paths": [
        "projt-modpack/"
      ],
      "depends_on": [],
      "runner": "modpacks"
    },
    "ptlibzippy": {
      "description": "Bundled zlib-compatible library used by launcher and QuaZip.",
      "paths": [
        "ptlibzippy/"
      ],
      "depends_on": []
    },
    "murmur2": {
      "description": "Bundled MurmurHash2 helper consumed by the launcher.",
      "paths": [
        "murmur2/"
      ],
      "depends_on": [],
      "runner": "murmur2"
    },
    "qdcss": {
      "description": "Bundled Qt stylesheet parser consumed by the launcher.",
      "paths": [
        "qdcss/"
      ],
      "depends_on": [],
      "runner": "qdcss"
    },
    "rainbow": {
      "description": "Bundled Qt color helper consumed by the launcher.",
      "paths": [
        "rainbow/"
      ],
      "depends_on": [],
      "runner": "rainbow"
    },
    "systeminfo": {
      "description": "Bundled system information helper consumed by the launcher.",
      "paths": [
        "systeminfo/"
      ],
      "depends_on": [],
      "runner": "systeminfo"
    },
    "tomlplusplus": {
      "description": "Bundled TOML parser consumed by the launcher.",
      "paths": [
        "tomlplusplus/"
      ],
      "depends_on": []
    },
    "uvim": {
      "description": "Standalone uvim fork.",
      "paths": [
        "uvim/"
      ],
      "depends_on": [],
      "runner": "uvim"
    }
  }
}
